#! /usr/bin/env fish
# alias: brew search-filtered
#
# This is just a basic script that filters out forbidden formula & casks from
# brew search. It gets the list from `chezmoi data` because I didn't feel like
# making proper templates for this.

argparse formula cask desc -- $argv
or return
if not set -q _flag_cask
    if set -q _flag_desc
        # brew search --desc is broken lmao not reporting that shit
        # brew search --formula --desc --eval-all $argv | rg -vFf (chezmoi data | jq -r '"\(.settings.homebrew.forbidden.formula[]):"' | psub)
        # brew desc --search --formula --eval-all $argv | rg -vFf (chezmoi data | jq -r '"\(.settings.homebrew.forbidden.formula[]):"' | psub)
        brew desc --search --formula $argv | string match -vr "^($(string replace -a ' ' '|' $HOMEBREW_FORBIDDEN_FORMULAE)):"
    else
        brew search --formula $argv | rg -vFf (string split ' ' $HOMEBREW_FORBIDDEN_FORMULAE | psub)
    end
    if not set -q _flag_formula
        echo
    end
end
if not set -q _flag_formula
    if set -q _flag_desc
        # brew search --cask --desc --eval-all $argv | rg -vFf (chezmoi data | jq -r '"\(.settings.homebrew.forbidden.cask[]):"' | psub)
        # brew desc --search --cask --eval-all $argv | rg -vFf (chezmoi data | jq -r '"\(.settings.homebrew.forbidden.cask[]):"' | psub)
        brew desc --search --cask $argv | string match -vr "^($(string replace -a ' ' '|' $HOMEBREW_FORBIDDEN_CASKS)):"
    else
        brew search --cask $argv | rg -vFf (string split ' ' $HOMEBREW_FORBIDDEN_CASKS | psub)
    end
end
