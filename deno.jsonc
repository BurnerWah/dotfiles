{
  "minimumDependencyAge": { "age": "P7D" },
  "nodeModulesDir": "none",
  "fmt": {
    // Deno formatting is currently not used, but that may change in the future
    "singleQuote": true,
    "semiColons": false,
    "exclude": [
      "schemas/generated",
      "schemas/vendor",
      "home/dot_config/*_nvim/lazy-lock.json",
      ".vscode/*.json",
      "**/*.json",
      "**/*.jsonc",
      "**/*.yaml",
      "**/*.yml",
      "**/*.xml",
    ],
  },
}
